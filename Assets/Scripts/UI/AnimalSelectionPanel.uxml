<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="SelectionContainer" style="position: absolute; width: 320px; background-color: rgba(0, 0, 0, 0.9); padding: 15px; border-radius: 10px; border-width: 2px; border-color: rgb(100, 150, 100); background-image: resource(&apos;UI/background&apos;);">
        <ui:Label name="SelectionTitle" text="Select Animal" style="font-size: 18px; -unity-font-style: bold; margin-bottom: 10px; color: rgb(255, 255, 255); background-image: resource(&apos;UI/redbutton_pressed&apos;);" />
        <ui:ScrollView name="SelectionScrollView" style="flex-grow: 1; max-height: 400px;">
            <ui:VisualElement name="SelectionListContainer" style="flex-grow: 1;" />
        </ui:ScrollView>
        <ui:Button name="CancelButton" text="Cancel" style="margin-top: 10px; padding: 8px; background-color: rgb(100, 100, 100); color: rgb(255, 255, 255); background-image: resource(&apos;UI/redbutton&apos;);" />
    </ui:VisualElement>
</ui:UXML>
